{
  "name": "aro-mcs-framework",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run lint && vite build",
    "build:dev": "vite build --mode development",
    "type-check": "tsc -b",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "preview": "vite preview --port 8484",
    "check": "npm run lint && npm run format:check",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format:tailwind": "prettier --write **/*.{js,jsx,ts,tsx,html,css,md}",
    "format:imports": "oxlint ./src --fix",
    "format:all": "npm run lint:fix && npm run format",
    "gen:types": "dotenv -- sh -c 'supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > src/integrations/supabase/type.ts.tmp && mv src/integrations/supabase/type.ts.tmp src/integrations/supabase/type.ts || (rm -f src/integrations/supabase/type.ts.tmp; exit 1)'",
    "db:mig:new": "supabase migration new",
    "db:diff": "dotenv -- sh -c 'supabase db diff --linked -f $(date +\"%Y%m%d_%H%M%S\")'",
    "db:push": "supabase db push",
    "db:studio": "open https://supabase.com/dashboard/project/$npm_config_ref/editor",
    "sb:login": "dotenv -- sh -c 'supabase login --token $SUPABASE_ACCESS_TOKEN'",
    "sb:link": "dotenv -- sh -c 'supabase link --project-ref $SUPABASE_PROJECT_ID'",
    "fn:deploy:all": "supabase functions deploy"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.58.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv-cli": "^7.4.4",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
